<Project Sdk="Microsoft.NET.Sdk">
  <!-- Decoder fixture tests for the hand-written C# wire codec (D5,
       docs/decision-client-bindings.md). Validates EventPayloadDecoder
       against golden JSON fixtures shaped from crates/anima-channel/src/wire.rs.
       Run: dotnet test godot/ -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Compile the decoder + wire types + renderer boundary directly into the test assembly.
       The Godot.NET.Sdk project cannot be referenced from a plain dotnet
       test project, and these are pure C# with no Godot deps. -->
  <ItemGroup>
    <Compile Include="../scripts/Net/DaemonEvents.cs" Link="Net/DaemonEvents.cs" />
    <Compile Include="../scripts/Net/EventPayloadDecoder.cs" Link="Net/EventPayloadDecoder.cs" />
    <Compile Include="../scripts/Renderers/IPetRenderer.cs" Link="Renderers/IPetRenderer.cs" />
    <Compile Include="../scripts/Renderers/CardRenderConfig.cs" Link="Renderers/CardRenderConfig.cs" />
    <Compile Include="../scripts/Renderers/PetRendererFactory.cs" Link="Renderers/PetRendererFactory.cs" />
    <Compile Include="../scripts/Renderers/Live2dRenderer.cs" Link="Renderers/Live2dRenderer.cs" />
    <Compile Include="../scripts/Renderers/VrmRenderer.cs" Link="Renderers/VrmRenderer.cs" />
    <Compile Include="../scripts/Renderers/LipSyncSmoother.cs" Link="Renderers/LipSyncSmoother.cs" />
    <Compile Include="../scripts/Renderers/GenericPetRenderer.cs" Link="Renderers/GenericPetRenderer.cs" />
    <Compile Include="../scripts/Net/DaemonClient.cs" Link="Net/DaemonClient.cs" />
    <Compile Include="../scripts/Net/DaemonRpc.cs" Link="Net/DaemonRpc.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rust-canonical golden event frames are the single source of truth for
         the decoder (D5). Copied read-only from crates/anima-channel/fixtures/golden. -->
    <None Include="../../crates/anima-channel/fixtures/golden/event.*.json"
          Link="golden/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>