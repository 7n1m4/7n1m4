{"id": "PORT-01", "prompt": "Add typed providers.list, providers.save, providers.delete wrappers to DaemonClient in apps/flutter/lib/daemon_client/daemon_client.dart and migrate ProvidersScreen off raw client.call('providers.*') strings.", "tags": ["typed-rpc-wrapper"], "allowed_paths": ["apps/flutter/lib/daemon_client/daemon_client.dart", "apps/flutter/lib/features/providers/providers_screen.dart"], "forbidden_paths": ["apps/flutter/lib/features/settings/settings_screen.dart", "crates/"], "required_patterns": ["providersList", "providersSave", "providersDelete"], "forbidden_patterns": ["'providers.list'", "'providers.save'", "'providers.delete'"], "verify_commands": ["sh -c 'cd apps/flutter && dart analyze lib/daemon_client/daemon_client.dart'", "rg -q 'providers(List|Save|Delete)' apps/flutter/lib/daemon_client/daemon_client.dart"], "expected_files": ["apps/flutter/lib/daemon_client/daemon_client.dart"], "notes": "Typed wrappers promote non-ok replies to DaemonClientException kind rpc."}
