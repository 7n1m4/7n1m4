        },
        {
          "guard": "flutter_boundary_graph.mjs",
          "expected_exit_code": 1,
          "expected_stderr_substring": "capability=package:hive/",
          "should_kill": true
        }
      ],
      "expected_kills": 2
    },
    {
      "id": "relative-traversal",
      "control": false,
      "fault_class": "path-escape",
      "operator": "REWRITE_RELATIVE_URI_TRAVERSAL",
      "fixture": "relative-traversal.dart",
      "target": {
        "file": "apps/flutter/lib/formatters/pure_formatter.dart",
        "line": 2,
        "col": 1,
        "needle": "import '../../outside.dart';"
      },
      "guards": [
        {
          "guard": "flutter-boundary.test.mjs",
          "expected_exit_code": 1,
          "expected_stderr_substring": "escapes lib root",
          "should_kill": true
        },
        {
          "guard": "flutter_boundary_graph.mjs",
          "expected_exit_code": 0,
          "expected_stderr_substring": null,
          "should_kill": false
        }
      ],
      "expected_kills": 1
    },
    {
