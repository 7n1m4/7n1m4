# D-Bus activation for org.moeru.airi.Daemon1.
# Install to ~/.local/share/dbus-1/services/org.moeru.airi.Daemon1.service
# Per dbus-daemon(1), the
# per-user servicedir is read for the session bus; no root needed.
#
# Note: SystemdService is set below so activation routes through systemd
# (and gets Restart= for free). Exec remains the fallback when systemd is
# unavailable. See packaging/README.md.
[D-BUS Service]
Name=org.moeru.airi.Daemon1
SystemdService=anima-daemon.service
Exec=%h/.local/bin/anima-daemon
